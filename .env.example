# 默认天气服务：openmeteo、openweather、qweather、weatherapi 或 visualcrossing。
# openmeteo 无需 API Key。
WEATHER_PROVIDER=openmeteo

# development 允许本机配置页；production 会关闭配置页并启用聊天限流。
APP_ENV=development
CHAT_RATE_LIMIT_PER_MINUTE=30

# 白名单外城市使用 Nominatim 地理编码；公开服务要求明确 User-Agent。
# 如果后续改用自托管或兼容服务，只需替换 URL，无需修改代码。
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=weather-agent/1.0 (https://github.com/Holmes522/weather-agent)

# 和风天气：API Host 是控制台分配的专属主机名，不要包含 https:// 或路径。
QWEATHER_API_KEY=replace-with-your-qweather-key
QWEATHER_API_HOST=replace-with-your-host.qweatherapi.com

# 可选：配置后可在单次 /chat 请求中选择 openweather。
OPENWEATHER_API_KEY=replace-with-your-openweathermap-key

# 可选：WeatherAPI.com 与 Visual Crossing。
WEATHERAPI_API_KEY=replace-with-your-weatherapi-key
VISUAL_CROSSING_API_KEY=replace-with-your-visual-crossing-key
